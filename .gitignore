# 本地运行环境与 colcon 产物
/.venv/
/.vscode/
/build/
/install/
/log/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# 原始数据、压缩包、地图数据库和完整日志仅保留在本地。
/data/*
!/data/.gitkeep
/outputs/*
!/outputs/.gitkeep

